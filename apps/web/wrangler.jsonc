{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aidcco2-bupt",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "aidcco2.bupt.ai",
      "custom_domain": true
    }
  ]
}
